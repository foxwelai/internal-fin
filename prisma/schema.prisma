// Foxwel Finance — schema
//
// Money is stored as BigInt paise everywhere. Business dates are stored as
// SQL DATE (@db.Date) because they are calendar dates, not instants; audit
// timestamps use timestamptz.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/* -------------------------------------------------------------------------- */
/* Auth                                                                        */
/* -------------------------------------------------------------------------- */

/// Access level. Which permissions each role carries is decided by
/// src/lib/permissions.ts; who holds which role lives here, in the database.
enum UserRole {
  /// Root access: everything, including approving people and company settings.
  SUPER_ADMIN
  /// Everything financial. Cannot manage people or company settings.
  ADMIN
  /// Read-only.
  VIEWER
}

/// A person known to the app. Sign-in itself is handled by Clerk; this row is
/// what decides whether that person may see anything, and with which role.
model User {
  id           String    @id @default(cuid())
  /// Clerk's user id, set the first time this person signs in.
  clerkUserId  String?   @unique
  email        String    @unique
  name         String
  /// Left over from before Clerk. Never read; kept only so no history is lost.
  passwordHash String?
  role         UserRole  @default(VIEWER)
  /// Null until a super admin approves this person. Someone who signs up is
  /// recorded as a request and sees no data until then.
  approvedAt   DateTime?
  approvedById String?
  /// Revoking access without deleting the record. Checked on every request.
  isActive     Boolean   @default(true)
  /// Set when a super admin adds someone ahead of their first sign-in.
  createdById  String?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  createdBy     User?  @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers  User[] @relation("UserCreatedBy")
  approvedBy    User?  @relation("UserApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedUsers User[] @relation("UserApprovedBy")
  reviewRequests ClientReview[]

  @@index([isActive])
  @@index([approvedAt])
  @@map("users")
}

/* -------------------------------------------------------------------------- */
/* Clients & projects                                                          */
/* -------------------------------------------------------------------------- */

model Client {
  id            String   @id @default(cuid())
  /// The business, as the team refers to it. Shown everywhere a client is named.
  name          String
  /// The registered entity that appears on an invoice, when it differs.
  companyName   String?
  /// The person who owns the relationship on the client's side — the owner or
  /// decision maker. Required by the form; nullable for clients added earlier.
  clientName    String?
  website       String?
  /// Day-to-day point of contact, when it is someone other than the client.
  contactPerson String?
  contactPhone  String?
  email         String?
  /// The client's own number.
  phone         String?
  notes         String?
  isDemo        Boolean  @default(false)
  archivedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  projects Project[]
  /// The lead this client was won from, if any.
  leads    Lead[]

  @@index([archivedAt])
  @@index([name])
  @@map("clients")
}

enum ProjectStatus {
  PENDING
  APPROVED
  ON_HOLD
}

/// Where the delivery work stands. Separate from ProjectStatus, which decides
/// whether a project is forecast at all.
enum ProjectProgress {
  NOT_STARTED
  JUST_STARTED
  IN_PROGRESS
  COMPLETED
}

enum BillingType {
  /// A fixed piece of work with a total agreed value.
  ONE_TIME
  /// A retainer or subscription that renews on an interval.
  SUBSCRIPTION
}

enum RecurringInterval {
  MONTHLY
  QUARTERLY
  YEARLY
}

/// How a referral commission is worked out.
enum CommissionBasis {
  /// A share of money actually collected, so nothing is owed on an unpaid
  /// invoice. Held in basis points to keep the arithmetic in integers.
  PERCENT_OF_RECEIVED
  /// A flat amount agreed up front.
  FIXED
}

model Project {
  id                     String        @id @default(cuid())
  clientId               String
  name                   String
  description            String?
  /// Total agreed budget, in paise.
  budgetPaise            BigInt
  status                 ProjectStatus @default(PENDING)
  startDate              DateTime?     @db.Date
  expectedCompletionDate DateTime?     @db.Date
  notes                  String?

  /// Where the work lives — a staging site, a repo, a brief. Optional.
  projectUrl             String?

  /// Subscription work carries a recurring price alongside the total value.
  billingType            BillingType        @default(ONE_TIME)
  recurringInterval      RecurringInterval?
  recurringAmountPaise   BigInt?

  /// Referral commission owed to whoever brought the project in.
  commissionBasis        CommissionBasis?
  commissionPayee        String?
  /// Basis points, so 12.5% is 1250 and no float is involved.
  commissionRateBps      Int?
  commissionAmountPaise  BigInt?
  commissionNotes        String?

  /// Foxwel's own coordinator and point of contact for the work.
  coordinatorId          String?

  progress               ProjectProgress @default(NOT_STARTED)
  /// 0–100.
  progressPercent        Int             @default(0)
  /// What has been delivered so far, in plain words.
  progressNotes          String?
  completedOn            DateTime?       @db.Date

  isDemo                 Boolean       @default(false)
  archivedAt             DateTime?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  client             Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  coordinator        TeamMember?         @relation(fields: [coordinatorId], references: [id], onDelete: SetNull)
  schedules          PaymentSchedule[]
  receipts           Receipt[]
  commissionPayments CommissionPayment[]
  reviews            ClientReview[]

  @@index([clientId])
  @@index([status])
  @@index([progress])
  @@index([coordinatorId])
  @@index([archivedAt])
  @@map("projects")
}

enum TeamMemberKind {
  EMPLOYEE
  INTERN
}

/// Foxwel's own people, as they are assigned to work. Not the same as `User`:
/// a coordinator needs a name and a phone number, not a login.
model TeamMember {
  id          String         @id @default(cuid())
  kind        TeamMemberKind @default(EMPLOYEE)
  name        String
  phone       String?
  email       String?
  designation String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  coordinatedProjects Project[]
  ownedLeads          Lead[]

  @@index([isActive])
  @@map("team_members")
}

/* -------------------------------------------------------------------------- */
/* Leads                                                                       */
/* -------------------------------------------------------------------------- */

enum LeadStage {
  /// First conversation has happened.
  JUST_SPOKE
  /// Requirements, proposal, negotiation — actively being worked.
  IN_PROCESS
  /// Closed and won: the lead has become a client.
  WON
  /// Closed without a deal.
  LOST
}

enum LeadQuality {
  HOT
  WARM
  COLD
}

enum LeadSource {
  REFERRAL
  WEBSITE
  SOCIAL
  OUTREACH
  EVENT
  EXISTING_CLIENT
  OTHER
}

/// A prospective client. Carries the same contact details as a client, so
/// winning it turns it into one without retyping anything.
model Lead {
  id                 String      @id @default(cuid())
  /// Company name — becomes Client.name on conversion.
  name               String
  clientName         String
  phone              String
  contactPerson      String?
  contactPhone       String?
  email              String?
  website            String?

  stage              LeadStage   @default(JUST_SPOKE)
  quality            LeadQuality @default(WARM)
  source             LeadSource?
  /// What the work is expected to be worth, in paise.
  expectedValuePaise BigInt?
  /// First day of the month the deal is expected to close in.
  expectedCloseMonth DateTime?   @db.Date
  requirement        String?
  ownerId            String?
  nextFollowUpOn     DateTime?   @db.Date
  lostReason         String?
  closedOn           DateTime?   @db.Date
  notes              String?

  /// Set when the lead is won and becomes (or is matched to) a client.
  clientId           String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  owner  TeamMember? @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  client Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([stage])
  @@index([expectedCloseMonth])
  @@index([createdAt])
  @@map("leads")
}

/// Who a review link was sent to.
enum ReviewRecipient {
  /// The client themselves — the owner or decision maker.
  CLIENT
  POINT_OF_CONTACT
}

/// One review link sent to a client, and their answer once they fill it in.
/// The link carries a random token; only its SHA-256 hash is stored, so the
/// table alone cannot be used to submit a review.
model ClientReview {
  id             String          @id @default(cuid())
  projectId      String
  tokenHash      String          @unique
  recipient      ReviewRecipient
  recipientName  String
  recipientPhone String?
  requestedById  String?
  requestedAt    DateTime        @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?

  submittedAt    DateTime?
  /// 1–5.
  rating         Int?
  whatWentWell   String?
  couldImprove   String?
  reviewerName   String?
  /// The client agreed their words may be quoted publicly.
  canQuote       Boolean         @default(false)

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requestedBy User?   @relation(fields: [requestedById], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([submittedAt])
  @@map("client_reviews")
}

/* -------------------------------------------------------------------------- */
/* Expected payments vs. actual receipts                                       */
/* -------------------------------------------------------------------------- */

/// An *expected* payment: a line in the project's collection schedule.
/// Never counted as income on its own — only its allocations are real money.
model PaymentSchedule {
  id          String    @id @default(cuid())
  projectId   String
  label       String
  amountPaise BigInt
  dueDate     DateTime  @db.Date
  notes       String?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  allocations ReceiptAllocation[]

  @@index([projectId])
  @@index([dueDate])
  @@map("payment_schedules")
}

enum PaymentMethod {
  BANK_TRANSFER
  UPI
  CHEQUE
  CASH
  CARD
  OTHER
}

/// Money that actually arrived. Exists independently of any schedule, so an
/// advance can be recorded before the schedule is drawn up.
model Receipt {
  id          String        @id @default(cuid())
  projectId   String
  amountPaise BigInt
  receivedOn  DateTime      @db.Date
  method      PaymentMethod @default(BANK_TRANSFER)
  reference   String?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  allocations ReceiptAllocation[]

  @@index([projectId])
  @@index([receivedOn])
  @@map("receipts")
}

/// Links part of a receipt to a scheduled payment. A receipt may be split
/// across several schedule lines, or left wholly/partly unallocated.
model ReceiptAllocation {
  id          String   @id @default(cuid())
  receiptId   String
  scheduleId  String
  amountPaise BigInt
  createdAt   DateTime @default(now())

  receipt  Receipt         @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  schedule PaymentSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([receiptId, scheduleId])
  @@index([scheduleId])
  @@map("receipt_allocations")
}

/// Money actually paid to a referrer. Kept apart from operating expenses so a
/// commission never lands in an expense category by accident.
model CommissionPayment {
  id          String        @id @default(cuid())
  projectId   String
  amountPaise BigInt
  paidOn      DateTime      @db.Date
  method      PaymentMethod @default(BANK_TRANSFER)
  reference   String?
  notes       String?
  createdAt   DateTime      @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([paidOn])
  @@map("commission_payments")
}

/* -------------------------------------------------------------------------- */
/* Borrowing                                                                   */
/* -------------------------------------------------------------------------- */

enum LoanStatus {
  ACTIVE
  CLOSED
}

/// Money borrowed by the business. Financing, not trading: the principal
/// arriving and each repayment move the cash balance, and neither ever touches
/// collections, expenses or the operating surplus.
model Loan {
  id              String     @id @default(cuid())
  lender          String
  principalPaise  BigInt
  /// Basis points; 12.5% a year is 1250. Informational — repayments are
  /// recorded as they happen rather than amortised.
  interestRateBps Int?
  receivedOn      DateTime   @db.Date
  dueDate         DateTime?  @db.Date
  reference       String?
  notes           String?
  status          LoanStatus @default(ACTIVE)
  isDemo          Boolean    @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  payments LoanPayment[]

  @@index([status])
  @@index([receivedOn])
  @@map("loans")
}

model LoanPayment {
  id          String        @id @default(cuid())
  loanId      String
  amountPaise BigInt
  paidOn      DateTime      @db.Date
  method      PaymentMethod @default(BANK_TRANSFER)
  reference   String?
  notes       String?
  createdAt   DateTime      @default(now())

  loan Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([loanId])
  @@index([paidOn])
  @@map("loan_payments")
}

/* -------------------------------------------------------------------------- */
/* Monthly expenses                                                            */
/* -------------------------------------------------------------------------- */

enum ExpenseCategory {
  SALARIES
  RENT
  SOFTWARE
  UTILITIES
  MARKETING
  FREELANCERS
  TRAVEL
  MISC
}

/// Blueprint for an expense that repeats every month. Editing a template
/// never rewrites months already generated from it.
model RecurringExpenseTemplate {
  id           String          @id @default(cuid())
  name         String
  category     ExpenseCategory
  amountPaise  BigInt
  dueDayOfMonth Int?
  notes        String?
  isActive     Boolean         @default(true)
  isDemo       Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  expenses MonthlyExpense[]

  @@index([isActive])
  @@map("recurring_expense_templates")
}

/// One budgeted expense line, attributed to exactly one month. The month it
/// belongs to is independent of when cash actually left the account.
model MonthlyExpense {
  id           String          @id @default(cuid())
  name         String
  category     ExpenseCategory
  plannedPaise BigInt
  periodYear   Int
  periodMonth  Int
  dueDate      DateTime?       @db.Date
  isRecurring  Boolean         @default(false)
  templateId   String?
  notes        String?
  isDemo       Boolean         @default(false)
  archivedAt   DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  template RecurringExpenseTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  payments ExpensePayment[]

  /// Makes recurring generation idempotent: re-running it for a month cannot
  /// create a second row for the same template.
  @@unique([templateId, periodYear, periodMonth], name: "template_period")
  @@index([periodYear, periodMonth])
  @@index([category])
  @@map("monthly_expenses")
}

model ExpensePayment {
  id          String        @id @default(cuid())
  expenseId   String
  amountPaise BigInt
  paidOn      DateTime      @db.Date
  method      PaymentMethod @default(BANK_TRANSFER)
  reference   String?
  notes       String?
  createdAt   DateTime      @default(now())

  expense MonthlyExpense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([expenseId])
  @@index([paidOn])
  @@map("expense_payments")
}

/* -------------------------------------------------------------------------- */
/* Assets                                                                      */
/* -------------------------------------------------------------------------- */

/// Created on the fly from the asset form, then reused.
model AssetCategory {
  id        String   @id @default(cuid())
  name      String
  /// Lower-cased name, so "Laptops" and "laptops" are one category.
  nameKey   String   @unique
  createdAt DateTime @default(now())

  assets Asset[]

  @@map("asset_categories")
}

/// Something the company owns — a Mac mini, a monitor, a phone. A register,
/// not an expense: buying one is recorded under expenses as usual.
model Asset {
  id            String    @id @default(cuid())
  name          String
  categoryId    String
  specification String?
  serialNumber  String?
  purchasedOn   DateTime? @db.Date
  costPaise     BigInt?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  category AssetCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  bill     AssetBill?

  @@index([categoryId])
  @@map("assets")
}

/// The purchase bill, kept in its own table so listing assets never loads the
/// file itself. Stored in Cloudinary when it is configured, otherwise in `data`.
model AssetBill {
  id                     String   @id @default(cuid())
  assetId                String   @unique
  fileName               String
  contentType            String
  sizeBytes              Int
  data                   Bytes?
  /// Private ("authenticated") Cloudinary asset; only this app can fetch it.
  cloudinaryPublicId     String?
  /// "image" or "raw" — Cloudinary files PDFs as raw so they deliver reliably.
  cloudinaryResourceType String?
  uploadedAt             DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@map("asset_bills")
}

/* -------------------------------------------------------------------------- */
/* Cash position                                                               */
/* -------------------------------------------------------------------------- */

/// Non-operating cash movements. Kept apart from collections and expenses so
/// funding and owner draws never flatter (or dent) the operating result.
enum CashMovementType {
  FUNDING
  OWNER_CONTRIBUTION
  OWNER_WITHDRAWAL
  TRANSFER_IN
  TRANSFER_OUT
}

model CashMovement {
  id          String           @id @default(cuid())
  type        CashMovementType
  amountPaise BigInt
  occurredOn  DateTime         @db.Date
  label       String
  notes       String?
  isDemo      Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([occurredOn])
  @@map("cash_movements")
}

/// Single-row configuration table.
model AppSettings {
  id                   String    @id @default("singleton")
  companyName          String    @default("foxwel.ai")
  openingBalancePaise  BigInt?
  openingBalanceDate   DateTime? @db.Date
  /// True when the opening balance came from the demo dataset, so removing
  /// demo data can clear it without touching a real configured balance.
  openingBalanceIsDemo Boolean   @default(false)
  fiscalYearStartMonth Int       @default(4)
  updatedAt            DateTime  @updatedAt

  @@map("app_settings")
}
