# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Any PostgreSQL 14+ instance. The value below matches `npm run db:start`,
# which boots a throwaway local server into ./.devdb with no system install.
# In production, point this at your managed Postgres and add ?sslmode=require.
DATABASE_URL="postgresql://foxwel:foxwel@localhost:55432/foxwel_finance"

# Only needed when the host above is a connection pooler that cannot run
# migrations — Neon, Supabase, PgBouncer. Point this at the direct endpoint.
# On Neon that is the same host with the "-pooler" suffix removed.
# Leave unset for a plain PostgreSQL instance.
DIRECT_URL=""

# ---------------------------------------------------------------------------
# Authentication (Auth.js v5)
# ---------------------------------------------------------------------------
# Generate with:  openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-32-byte-random-string"
# Auth.js infers the site URL from the incoming request (the app sets
# `trustHost`), which is what makes localhost, Vercel preview URLs and the
# production domain all work with no configuration.
#
# Do NOT set AUTH_URL unless you have a specific reason. A value left over from
# local development is the classic cause of "signing in on the deployed site
# sends me to localhost".
#
# If you do set it on a host, use the site's own https URL. Never put an https
# URL in a local .env: Auth.js then names the session cookie
# __Secure-authjs.session-token, and a browser will not store or send a
# __Secure- cookie over http://localhost, so signing in locally would appear to
# work and then silently do nothing.
# AUTH_URL="https://your-app.vercel.app"
# Set to 1 when running behind a reverse proxy / on a platform host.
AUTH_TRUST_HOST="1"

# ---------------------------------------------------------------------------
# Owner account created by `npm run db:seed`
# ---------------------------------------------------------------------------
# Creates the FIRST owner account, and only when the users table is empty.
# Everyone after that is added from Settings -> Team inside the app, so these
# are not needed on your hosting provider.
OWNER_EMAIL="owner@example.com"
OWNER_NAME="Owner"
# No default on purpose: the seed refuses to run without one of at least 12
# characters, so an installation can never end up with a password from a file
# that is checked into version control.
OWNER_PASSWORD=""

# ---------------------------------------------------------------------------
# Demo data
# ---------------------------------------------------------------------------
# `npm run db:seed:demo` loads a clearly-labelled fictional dataset.
# It is never loaded automatically and can be removed from Settings.
